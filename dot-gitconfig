# Sample gitconfig
#

[hub]
        protocol = https
[user]
        name = marcusmyers
        email = marcusmyers@gmail.com
[credential]
        helper = cache
[alias]
	co = checkout
        count   = !git shortlog -sn
	st = status
	ci = commit
	br = branch
	cleanlocal = "!f() { branch=$(git current) || exit 1; case $branch in main|master) ;; *) printf 'Delete branches merged into %s? (y/n) ' \"$branch\"; read answer; case $answer in y|Y) ;; *) echo 'Nothing done'; exit 0 ;; esac ;; esac; git for-each-ref --format='%(refname:short)' --merged \"$branch\" refs/heads | while IFS= read -r stale; do test \"$stale\" = \"$branch\" || git branch -d \"$stale\"; done; }; f"
	current = !git rev-parse --abbrev-ref HEAD
	some = !git checkout master && git pull --rebase && git remote prune origin && git cleanlocal
	msome = !git checkout main && git pull --rebase && git remote prune origin && git cleanlocal
[color]
	diff = auto
	status = auto
	branch = auto
        ui = true
	interactive = auto
[core]
	excludesfile = ~/.gitignore
        editor = nvim
[apply]
        whitespace = nowarn
[mergetool]
        keepBackup = false
[difftool]
        prompt = false
[help]
        autocorrect = 1
[push]
        # See `git help config` (search for push.default)
        # for more information on different options of the below setting.
        #
        # Setting to git 2.0 default to suppress warning message
	default = current
[merge]
	summary = true
[init]
	defaultBranch = main
[branch]
	autosetupmerge = true
[web]
	browser = chromium
[include]
	path = ~/.gitconfig.local
