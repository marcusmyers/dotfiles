#!/usr/bin/env bash

set -euo pipefail

DOTFILES_DIR="${1:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
LOCAL_CONFIG="$HOME/.gitconfig.local"

# Machine-specific paths and OS choices must not be written through the
# ~/.gitconfig symlink into the repository.
git config --file "$LOCAL_CONFIG" init.templatedir "$DOTFILES_DIR/git/templates"

if [ "$(uname -s)" = "Linux" ]; then
    git config --file "$LOCAL_CONFIG" web.browser chromium
else
    git config --file "$LOCAL_CONFIG" web.browser open
fi
